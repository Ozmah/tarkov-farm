{
	"name": "tarkov-season-docs",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"scripts": {
		"check": "biome check --write .",
		"glados": "biome check . && bun run typecheck && bun run build",
		"shodan": "bun run test && bun run screenshots:check",
		"shodan:watch": "bun run test --watch",
		"release:check": "bun run glados && bun run shodan",
		"dev": "bun run env:check && bun run db:setup && vite dev",
		"build": "vite build",
		"start": "bun run env:check && bun run db:setup && bun .output/server/index.mjs",
		"env:check": "bun scripts/check-env.ts",
		"images:masters": "bun scripts/generate-map-masters.ts",
		"images:responsive": "bun scripts/generate-map-masters.ts --responsive-only",
		"screenshots:check": "bun scripts/check-location-screenshots.ts",
		"updates:snapshot:check": "bun scripts/check-update-snapshot.ts",
		"updates:snapshot:sync": "bun scripts/check-update-snapshot.ts --write",
		"db:generate": "drizzle-kit generate",
		"db:manifest": "bun scripts/export-publication-data.ts",
		"db:migrate": "bun src/server/db/migrate.ts",
		"db:seed": "bun src/server/db/seed.ts",
		"db:setup": "bun src/server/db/setup.ts",
		"documents:images": "bun scripts/generate-document-images.ts",
		"preview": "bun run env:check && vite preview",
		"prepare": "husky || true",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"doctor": "react-doctor"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@js-temporal/polyfill": "0.5.1",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4",
		"@tanstack/react-router": "1.170.42",
		"@tanstack/react-start": "1.168.61",
		"@tanstack/router-plugin": "1.168.43",
		"@tursodatabase/database": "0.7.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "1.0.0-rc.4",
		"fflate": "0.8.3",
		"nitro": "3.0.260903-beta",
		"posthog-js": "1.438.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.13",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "1.0.0-rc.4",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"react-doctor": "^0.9.17",
		"shadcn": "^4.21.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	}
}

{
	"name": "tarkov-season-docs",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"check": "biome check --write .",
		"glados": "biome check . && bun run typecheck && bun run build",
		"release:check": "bun run glados && bun run screenshots:check",
		"dev": "bun run db:setup && vite dev",
		"build": "vite build",
		"images:masters": "bun scripts/generate-map-masters.ts",
		"screenshots:check": "bun scripts/check-location-screenshots.ts",
		"db:generate": "drizzle-kit generate",
		"db:export": "bun scripts/export-publication-data.ts",
		"db:migrate": "bun src/server/db/migrate.ts",
		"db:seed": "bun src/server/db/seed.ts",
		"db:snapshot": "bun scripts/create-database-snapshot.ts",
		"db:setup": "bun run db:migrate && bun run db:seed",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/router-plugin": "latest",
		"@tursodatabase/database": "0.7.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "1.0.0-rc.4",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.16.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@tanstack/devtools-vite": "^0.8.3",
		"@tanstack/react-devtools": "^0.10.9",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"drizzle-kit": "1.0.0-rc.4",
		"jsdom": "^28",
		"typescript": "^6",
		"vite": "^8",
		"vitest": "^4"
	}
}
